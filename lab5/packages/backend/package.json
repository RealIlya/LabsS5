{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:no-check": "tsc -p tsconfig.json || powershell -Command \"exit 0\"",
    "format:imports": "../frontend/node_modules/.bin/eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" --no-error-on-unmatched-pattern --config eslint.imports.config.mjs --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@hex/shared": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/platform-socket.io": "^10.4.5",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/websockets": "^10.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
