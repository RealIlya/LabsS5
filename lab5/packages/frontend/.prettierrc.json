{
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "arrowParens": "always",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["**/eslint.config.mjs", "**/*.config.*"],
      "options": { "quoteProps": "consistent" }
    }
  ]
}
